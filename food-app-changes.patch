+  assert.ok(mains.every((recipe) => recipe.cuisine === 'Indian'));
+  // Indian dishes are never adult-tiffin candidates (tiffin must be non-Indian).
+  assert.ok(mains.every((recipe) => !recipe.adultTiffin));
